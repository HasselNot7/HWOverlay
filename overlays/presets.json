{
  "presets": [
    {
      "id": "console-wide",
      "name": "全家桶控制台",
      "desc": "命令行装饰 + 四张全卡 + 九项小指标，一屏看全",
      "config": {
        "version": 2,
        "name": "monitor",
        "canvas": {
          "w": 2000,
          "h": 200,
          "theme": "nord-console",
          "padding": [
            12,
            24
          ]
        },
        "prompt": {
          "user": "streamer@pc",
          "cmd": "./sysmon --source=aida64 --interval=1s",
          "cursor": true,
          "size": 19
        },
        "widgets": [
          {
            "type": "cards",
            "cols": 4,
            "gap": 32,
            "items": [
              {
                "key": "cpu",
                "label": "CPU",
                "bar": "cpu.usage",
                "value": {
                  "metrics": [
                    "cpu.usage",
                    "cpu.temp"
                  ]
                },
                "sub": {
                  "sep": " · ",
                  "metrics": [
                    {
                      "metric": "cpu.clock_mhz",
                      "label": "主频"
                    },
                    {
                      "metric": "cpu.power_w",
                      "label": "功耗"
                    },
                    {
                      "metric": "cpu.volt",
                      "label": "电压"
                    }
                  ]
                },
                "spark": "cpu.usage"
              },
              {
                "key": "gpu",
                "label": "GPU",
                "bar": "gpu.usage",
                "value": {
                  "metrics": [
                    "gpu.usage",
                    "gpu.temp"
                  ]
                },
                "sub": {
                  "sep": " · ",
                  "metrics": [
                    {
                      "pair": [
                        "gpu.mem_used_mb",
                        "gpu.mem_total_mb"
                      ],
                      "divide": 1024,
                      "unit": "GB",
                      "digits": 1,
                      "digits2": 0,
                      "label": "显存"
                    },
                    {
                      "metric": "gpu.clock_mhz",
                      "label": "核心"
                    },
                    {
                      "metric": "gpu.mem_clock_mhz",
                      "label": "显存"
                    }
                  ]
                },
                "spark": "gpu.usage"
              },
              {
                "key": "ram",
                "label": "内存",
                "bar": "ram.pct",
                "value": {
                  "metrics": [
                    "ram.used",
                    "ram.total"
                  ]
                },
                "sub": {
                  "sep": " · ",
                  "metrics": [
                    {
                      "diff": [
                        "ram.total",
                        "ram.used"
                      ],
                      "unit": "GB 可用",
                      "digits": 1
                    },
                    {
                      "metric": "ram.pct",
                      "unit": "%",
                      "digits": 0
                    }
                  ]
                },
                "spark": "ram.pct"
              },
              {
                "key": "net",
                "label": "网络",
                "bar": "net.up_mbps",
                "value": {
                  "metrics": [
                    {
                      "metric": "net.up_mbps"
                    },
                    "net.down_mbps"
                  ]
                },
                "sub": {
                  "sep": " · ",
                  "metrics": [
                    {
                      "metric": "net.wifi_dbm",
                      "label": "WiFi"
                    }
                  ]
                },
                "spark": "net.up_mbps"
              }
            ]
          },
          {
            "type": "chips",
            "fit": "shrink",
            "items": [
              "cpu.socket_temp",
              "cpu.clock_mhz",
              "cpu.power_w",
              "cpu.fan_rpm",
              "gpu.hotspot",
              "gpu.power_w",
              "gpu.mem_temp",
              "misc.mobo_temp",
              "misc.dimm_max"
            ]
          }
        ]
      }
    },
    {
      "id": "bottom-bar",
      "name": "底部信息条",
      "desc": "1920×120，紧凑四卡 + 一行小指标，横贯屏幕底边",
      "config": {
        "version": 2,
        "name": "monitor",
        "canvas": {
          "w": 1920,
          "h": 120,
          "theme": "nord-console",
          "padding": [
            10,
            24
          ]
        },
        "widgets": [
          {
            "type": "cards",
            "cols": 4,
            "gap": 24,
            "item_height": 66,
            "items": [
              {
                "key": "cpu",
                "label": "CPU",
                "bar": "cpu.usage",
                "value": {
                  "metrics": [
                    "cpu.usage",
                    "cpu.temp"
                  ],
                  "sep": " | "
                }
              },
              {
                "key": "gpu",
                "label": "GPU",
                "bar": "gpu.usage",
                "value": {
                  "metrics": [
                    "gpu.usage",
                    "gpu.temp"
                  ],
                  "sep": " | "
                }
              },
              {
                "key": "ram",
                "label": "内存",
                "bar": "ram.pct",
                "value": {
                  "metrics": [
                    "ram.used",
                    "ram.total"
                  ],
                  "sep": " / "
                }
              },
              {
                "key": "net",
                "label": "网络",
                "bar": "net.down_mbps",
                "value": {
                  "metrics": [
                    "net.up_mbps",
                    "net.down_mbps"
                  ],
                  "sep": " ↑ | ↓ "
                }
              }
            ]
          },
          {
            "type": "chips",
            "fit": "shrink",
            "items": [
              "cpu.clock_mhz",
              "cpu.power_w",
              "gpu.power_w",
              "gpu.mem_temp",
              "net.wifi_dbm"
            ],
            "font": 14
          }
        ]
      }
    },
